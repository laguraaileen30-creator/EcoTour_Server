# EcoTour_Server Environment Template
PORT=5000
NODE_ENV=development

# MySQL Database Credentials
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# JWT & Cookie Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_here

# ── Email (reservation confirmations, account approvals) ──
# Use a Gmail address + a Gmail App Password (Google Account → Security → App passwords).
# Without these, emails go to a test inbox and the server logs a preview link instead of delivering.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password

# Public addresses used inside emails (Continue / Cancel links, login button).
# Change these to your real domain when the system is online so links work from a client's phone.
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
